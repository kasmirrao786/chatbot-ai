# --- Required for a minimal local run ---------------------------------
OPENROUTER_API_KEY=your-openrouter-key-here
PORT=3001

# --- LLM provider defaults (all optional — sensible defaults if unset) -
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# OPENROUTER_INTERNAL_MODEL=meta-llama/llama-3.3-70b-instruct:free
# MAX_CONCURRENT_PER_PROVIDER_KEY=3
# MAX_PROVIDER_QUEUE_WAIT_MS=8000

# --- Admin panel (/admin) -----------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
# Random 32+ char string signing admin session tokens — required in production.
ADMIN_SESSION_SECRET=change-me-too

# --- Persistence ---------------------------------------------------------
# Leave DATABASE_URL unset to run file-based (data/tenants/*.json) — fine
# for a single visa consultancy. Set it to run multi-tenant against
# Postgres instead — see db/schema.sql.
# DATABASE_URL=postgres://user:pass@host:5432/visa_assistant
# DATABASE_SSL=true
# DATABASE_POOL_MAX=10

# Redis — used for rate limiting and admin sessions if set; falls back to
# safe in-process behavior (fine for one instance) if left unset.
# REDIS_URL=redis://localhost:6379

# --- Rate limiting ---------------------------------------------------------
# RATE_LIMIT_PER_MINUTE=20

# --- Knowledge Base service (optional — see kb-service/README.md) ------
# KB_SERVICE_URL=http://localhost:8000
# KB_SERVICE_API_KEY=change-me
# How long /api/chat waits for a KB search before giving up and answering
# without it. Default (2500ms) is evidence-based from real production
# telemetry — every successful search completed in 749-1087ms, so this
# gives real headroom without risking a stuck request stalling a live chat
# turn. Raise this if your own baseline latency is genuinely higher.
# KB_FAST_TIMEOUT_MS=2500

# --- Misc ------------------------------------------------------------------
# Used in a couple of generated links (e.g. admin emails) — your public
# backend URL once deployed.
# PUBLIC_APP_URL=https://your-backend.example.com
